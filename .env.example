# Supabase 项目设置
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 会话签名密钥：建议使用 32 位以上随机字符串。空间密码会结合该密钥做哈希。
SESSION_SECRET=change-this-to-a-long-random-string

# 开发者管理密码：用于删除现有项目。只放在 Vercel 环境变量里，不要提交真实密码。
DEVELOPER_ADMIN_PASSWORD=change-this-admin-password

# AI 大模型 API Key（DeepSeek V4 Pro）
# 配置后，AI 将根据你的项目目标、时间、难度生成定制化阶段计划
# 如果不配置，AI 功能将使用内置规则引擎生成计划（固定模板拆日期）
# 获取方式：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxx-your-key-here
